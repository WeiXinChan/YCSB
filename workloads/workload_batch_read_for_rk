# Yahoo! Cloud System Benchmark
# Workload A: Update heavy workload
#   Application example: Session store recording recent actions
#                        
#   Read/update ratio: 50/50
#   Default data size: 1 KB records (10 fields, 100 bytes each, plus key)
#   Request distribution: zipfian

workload=com.yahoo.ycsb.workloads.CoreWorkload

# ATTENTION !!! 
# for batchput, if you want to insert record without duplication, 
# the recordcount mut be larger than or eqaul to batchput.size.per.op * operationcount
# otherwise, it may generate duplicate records and put operation will overwrite them
recordcount=10
operationcount=10
# The number of fields in a record
fieldcount=5
# The size of each field (in bytes)
fieldlength=100
insertproportion=0
readproportion=1
updateproportion=0
readmodifywriteproportion=0
scanproportion=0
# for batch operation
batchputproportion=0

load.use.batchput=true
batchput.size.per.op=10
batchput.issamepart.per.op=false

batchreadproportion=0
batchread.size.per.op=10

requestdistribution=uniform

# threadcounts
threadcount=1

#### 以下连接方式二选一 ####
hbase.oceanbase.odpMode=false
#### ODP模式（hbase.oceanbase.odpMode=true）####
hbase.oceanbase.odpAddr=
hbase.oceanbase.odpPort=
#### 直连模式（hbase.oceanbase.odpMode=false） ####
##### url不需要带引号 #####
hbase.oceanbase.paramURL=
hbase.oceanbase.sysUserName=
hbase.oceanbase.sysPassword=

#### 租户用户账密 #####
hbase.oceanbase.fullUserName=
hbase.oceanbase.password=

#### db、table、column family ####
hbase.oceanbase.database=
hbase.oceanbase.table=
hbase.oceanbase.columnFamily=

### range-key 二级分区表配置及生成数据的配置 ####
# 起始时间戳
current.mills=1758871588000
# range分区的时间间隔（ms）
table.range.mills=86400000
# 每个range分区容纳的数据量
range.rows.count=10
# uid的总数量
total.uid.count=10

# 扫描操作的配置
# 扫描的结果数
scan.rows=200
# 扫描一个range分区还是所有range分区
table.scan.one.part=true
debug=false