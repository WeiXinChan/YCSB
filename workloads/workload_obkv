# Yahoo! Cloud System Benchmark
# Workload A: Update heavy workload
#   Application example: Session store recording recent actions
#                        
#   Read/update ratio: 50/50
#   Default data size: 1 KB records (10 fields, 100 bytes each, plus key)
#   Request distribution: zipfian


workload=site.ycsb.workloads.CoreWorkload
readallfields=true

#### 运行参数 ####
recordcount=1
operationcount=1
threadcount=1
readproportion=0
updateproportion=0
scanproportion=0
insertproportion=1

#### 数据分布参数 ####
requestdistribution=uniform

# obkv configs
#### 连接参数 ####
obkv.isOdpMode=false
obkv.odpAddr=
obkv.odpPort=
# obkv.fullUserName=
# obkv.password=
obkv.database=

obkv.fullUserName=
obkv.configUrl=
obkv.password=
obkv.sysUserName=root
obkv.sysPassword=

#### 表属性参数 ####
obkv.isHeapTable=false
obkv.tableName=usertable
obkv.batchSize=1
obkv.dataLength=10240
obkv.threadCount=3

#### 查询参数 ####
rpc.operation.timeout=10000
rpc.execute.timeout=15000

#### 连接池 ####
server.connection.pool.size=50

### debug ###
obkv.debug=