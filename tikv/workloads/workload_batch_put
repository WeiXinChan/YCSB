# Yahoo! Cloud System Benchmark
# Workload A: Update heavy workload
#   Application example: Session store recording recent actions
#                        
#   Read/update ratio: 50/50
#   Default data size: 1 KB records (10 fields, 100 bytes each, plus key)
#   Request distribution: zipfian

workload=com.yahoo.ycsb.workloads.CoreWorkload

# ATTENTION !!! 
# for batchput, if you want to insert record without duplication, 
# the recordcount mut be larger than or eqaul to batchput.size.per.op * operationcount
# otherwise, it may generate duplicate records and put operation will overwrite them
recordcount=10000
operationcount=1000
orderinsert=ordered

# The number of fields in a record
fieldcount=1
# The size of each field (in bytes)
fieldlength=100

insertproportion=0
readproportion=0
updateproportion=0
readmodifywriteproportion=0
scanproportion=0
# for batch operation
batchputproportion=1
batchput.size.per.op=10

batchreadproportion=0
batchread.size.per.op=10

requestdistribution=uniform

# threadcounts
threadcount=400

#### TiKV连接配置 ####
# tikv.pd.addr (e.g. tikv.pd.addr=ip1,ip2,ip3)
tikv.pd.addr=11.162.217.150:2379,11.162.217.151:2379,11.162.217.153:2379
# debug mode
tikv.debug=true

#### 批量写入性能配置 ####
# 批量写入超时时间（毫秒）
tikv.batch.write.timeout=5000
# 批量写入线程数
tikv.batch.put.concurrency=20

#### 顺序写入配置 ####
# 是否启用顺序写入（每个线程写入不重叠的key范围）
batchput.sequential.enabled=true
# 顺序写入的起始key值
batchput.sequential.start=0